@startuml NexusMarket-Domain-Model

' ==========================================
' CONFIGURACION VISUAL
' ==========================================

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 50
skinparam defaultFontName Arial

top to bottom direction

' ==========================================
' 1. USUARIOS
' ==========================================

package "01. Usuarios" {

    class User {
        - identifier : String
        - fullName : String
        - email : Email
        - role : UserRole
        - status : UserStatus
    }

    class Buyer {
        - primaryAddress : Address
        - additionalAddresses : List<Address>
        - commercialStatus : BuyerStatus
    }

    class Seller {
        - status : SellerStatus
    }

    class Address {
        - street : String
        - city : String
        - state : String
        - postalCode : String
        - country : String
    }
}

' ==========================================
' 2. CATALOGO DE PRODUCTOS
' ==========================================

package "02. Catalogo" {

    class Product {
        - identifier : String
        - name : String
        - description : String
        - price : Money
        - type : ProductType
        - status : ProductStatus
    }

    class ProductVariant {
        - identifier : String
        - name : String
        - attributes : Map<String, String>
    }
}

' ==========================================
' 3. INVENTARIO Y ALMACENES
' ==========================================

package "03. Inventario" {

    class Warehouse {
        - identifier : String
        - name : String
        - address : Address
        - type : WarehouseType
    }

    class Inventory {
        - identifier : String
        - availableQuantity : int
        - reservedQuantity : int
        - status : InventoryStatus
    }

    class InventoryMovement {
        - identifier : String
        - type : InventoryMovementType
        - quantity : int
        - performedBy : User
    }
}

' ==========================================
' 4. CARRITO Y PEDIDOS
' ==========================================

package "04. Compras y pedidos" {

    class Cart {
        - identifier : String
    }

    class CartItem {
        - quantity : int
    }

    class Order {
        - identifier : String
        - total : Money
        - status : OrderStatus
        - creationDate : LocalDateTime
    }

    class OrderItem {
        - quantity : int
        - unitPrice : Money
    }
}

' ==========================================
' 5. PAGOS Y LOGISTICA
' ==========================================

package "05. Pagos y logistica" {

    class Invoice {
        - identifier : String
        - issueDate : LocalDateTime
        - subtotal : Money
        - total : Money
    }

    class Payment {
        - identifier : String
        - amount : Money
        - paymentDate : LocalDateTime
    }

    class Shipment {
        - identifier : String
        - shipmentDate : LocalDateTime
        - deliveryDate : LocalDateTime
    }

    class Return {
        - identifier : String
        - requestDate : LocalDateTime
        - reason : String
    }

    class Refund {
        - identifier : String
        - amount : Money
        - date : LocalDateTime
    }
}

' ==========================================
' 6. RELACIONES ENTRE USUARIOS
' ==========================================

User "1" -- "0..1" Buyer : perfil
User "1" -- "0..1" Seller : perfil

Buyer "1" *-- "1" Address : direccion principal
Buyer "1" *-- "0..*" Address : direcciones adicionales

' ==========================================
' 7. RELACIONES DEL CATALOGO
' ==========================================

Seller "1" -- "0..*" Product : publica
Product "1" *-- "0..*" ProductVariant : variantes

' ==========================================
' 8. RELACIONES DEL INVENTARIO
' ==========================================

Seller "1" -- "0..*" Warehouse : almacenes

Warehouse "1" *-- "1" Address : ubicacion

Product "1" -- "0..*" Inventory : inventario
Warehouse "1" -- "0..*" Inventory : contiene

Inventory "1" *-- "0..*" InventoryMovement : movimientos
User "1" -- "0..*" InventoryMovement : realiza

' ==========================================
' 9. RELACIONES DE COMPRAS Y PEDIDOS
' ==========================================

Buyer "1" *-- "1" Cart : carrito
Cart "1" *-- "0..*" CartItem : elementos

CartItem "*" --> "1" Product : producto
CartItem "*" --> "0..1" ProductVariant : variante

Buyer "1" -- "0..*" Order : realiza
Order "1" *-- "1..*" OrderItem : elementos

OrderItem "*" --> "1" Product : producto
OrderItem "*" --> "0..1" ProductVariant : variante

' ==========================================
' 10. RELACIONES DE PAGOS Y LOGISTICA
' ==========================================

Order "1" -- "0..1" Invoice : factura
Order "1" -- "0..1" Payment : pago
Order "1" -- "0..1" Shipment : envio
Order "1" -- "0..*" Return : devoluciones

Return "1" -- "0..1" Refund : reembolso

' ==========================================
' 11. RESTRICCIONES DEL MODELO
' ==========================================

note right of User
  Restriccion del negocio:
  Cada usuario debe tener
  un unico rol.
  
  Buyer y Seller representan
  perfiles asociados al usuario.
end note

note bottom of Warehouse
  WarehouseType distingue:
  MARKETPLACE y SELLER.
  
  La propiedad del almacen
  debe validarse segun su tipo.
end note

@enduml
